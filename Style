* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  color: #111827;
  background: #ffffff;
  line-height: 1.6;
}

.container {
  width: min(1100px, 92%);
  margin: auto;
}

/* HEADER */

.header {
  background: #ffffff;
  border-bottom: 1px solid #e5e7eb;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-content {
  min-height: 70px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  color: #111827;
  text-decoration: none;
  font-size: 22px;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 9px;
}

.logo-icon {
  width: 35px;
  height: 35px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  background: #111827;
  color: #ffffff;
  font-size: 23px;
}

nav {
  display: flex;
  gap: 28px;
}

nav a {
  color: #4b5563;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
}

nav a:hover {
  color: #111827;
}

/* HERO */

.hero {
  background: #f8fafc;
  padding: 85px 0;
}

.hero-content {
  text-align: center;
  display: flex;
  justify-content: center;
}

.hero-text {
  max-width: 750px;
}

.badge {
  display: inline-block;
  background: #e5e7eb;
  color: #111827;
  font-size: 12px;
  font-weight: 800;
  padding: 7px 14px;
  border-radius: 30px;
  margin-bottom: 20px;
}

.hero h1 {
  font-size: clamp(40px, 7vw, 70px);
  line-height: 1.05;
  letter-spacing: -2px;
  margin-bottom: 22px;
}

.hero h1 span {
  display: block;
}

.hero p {
  max-width: 650px;
  margin: auto;
  color: #6b7280;
  font-size: 18px;
}

.hero-button {
  display: inline-block;
  margin-top: 30px;
  padding: 14px 25px;
  border-radius: 10px;
  background: #111827;
  color: #ffffff;
  text-decoration: none;
  font-weight: 700;
}

.hero-button:hover {
  transform: translateY(-2px);
}

/* SECCIONES */

.generator-section,
.info-section,
.faq-section {
  padding: 85px 0;
}

.section-title {
  text-align: center;
  margin-bottom: 45px;
}

.small-title {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
  color: #6b7280;
}

.section-title h2 {
  font-size: 38px;
  margin: 8px 0;
}

.section-title p {
  color: #6b7280;
}

/* GENERADOR */

.generator-card {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 15px 45px rgba(0, 0, 0, 0.06);
}

.controls {
  padding: 35px;
}

.preview {
  padding: 35px;
  background: #f8fafc;
  border-left: 1px solid #e5e7eb;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.input-group {
  margin-bottom: 22px;
}

label {
  display: block;
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 8px;
}

input,
textarea,
select {
  width: 100%;
  border: 1px solid #d1d5db;
  border-radius: 9px;
  padding: 13px 14px;
  font-family: inherit;
  font-size: 15px;
  outline: none;
  background: #ffffff;
}

input:focus,
textarea:focus,
select:focus {
  border-color: #111827;
}

textarea {
  resize: vertical;
}

.type-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.type-btn {
  border: 1px solid #d1d5db;
  background: #ffffff;
  padding: 10px 13px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  color: #4b5563;
}

.type-btn:hover {
  border-color: #111827;
}

.type-btn.active {
  background: #111827;
  color: #ffffff;
  border-color: #111827;
}

.hidden {
  display: none !important;
}

/* WIFI */

.wifi-fields {
  margin-top: 5px;
}

/* PERSONALIZACIÓN */

.customization {
  border-top: 1px solid #e5e7eb;
  padding-top: 25px;
  margin-top: 25px;
}

.customization h3 {
  font-size: 18px;
  margin-bottom: 20px;
}

.color-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.color-control {
  display: flex;
  align-items: center;
  gap: 10px;
}

.color-control input[type="color"] {
  width: 48px;
  height: 42px;
  padding: 3px;
  cursor: pointer;
}

.color-control span {
  font-family: monospace;
  font-size: 13px;
}

.range-wrapper {
  display: flex;
  align-items: center;
  gap: 15px;
}

.range-wrapper input {
  padding: 0;
}

#size-value {
  min-width: 55px;
  font-weight: 700;
  font-size: 13px;
}

/* BOTÓN GENERAR */

.generate-button {
  width: 100%;
  border: none;
  padding: 15px;
  border-radius: 10px;
  background: #111827;
  color: #ffffff;
  font-size: 16px;
  font-weight: 800;
  cursor: pointer;
  margin-top: 5px;
}

.generate-button:hover {
  opacity: 0.9;
}

/* PREVIEW */

.preview-title {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 25px;
}

.preview-title h3 {
  font-size: 18px;
}

#status {
  font-size: 12px;
  color: #6b7280;
}

.qr-container {
  min-height: 330px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 1px dashed #d1d5db;
  border-radius: 15px;
  padding: 20px;
  overflow: auto;
}

.qr-container img,
.qr-container canvas {
  max-width: 100%;
  height: auto;
}

.qr-placeholder {
  text-align: center;
  color: #9ca3af;
}

.placeholder-icon {
  font-size: 65px;
  margin-bottom: 10px;
}

.qr-placeholder p {
  font-size: 14px;
}

.download-button {
  width: 100%;
  margin-top: 20px;
  padding: 14px;
  border: 1px solid #111827;
  background: #ffffff;
  color: #111827;
  border-radius: 10px;
  font-weight: 800;
  cursor: pointer;
}

.download-button:hover:not(:disabled) {
  background: #111827;
  color: #ffffff;
}

.download-button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

/* BENEFICIOS */

.benefits {
  background: #f8fafc;
  padding: 65px 0;
}

.benefits-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 25px;
}

.benefit {
  text-align: center;
}

.benefit-icon {
  font-size: 35px;
  margin-bottom: 12px;
}

.benefit h3 {
  font-size: 17px;
  margin-bottom: 7px;
}

.benefit p {
  color: #6b7280;
  font-size: 14px;
}

/* PASOS */

.steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.step {
  text-align: center;
  padding: 25px;
}

.step-number {
  width: 45px;
  height: 45px;
  margin: 0 auto 18px;
  border-radius: 50%;
  background: #111827;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.step h3 {
  margin-bottom: 10px;
}

.step p {
  color: #6b7280;
  font-size: 14px;
}

/* FAQ */

.faq-list {
  max-width: 800px;
  margin: auto;
}

details {
  border-bottom: 1px solid #e5e7eb;
  padding: 20px 0;
}

summary {
  cursor: pointer;
  font-weight: 700;
  font-size: 16px;
}

details p {
  color: #6b7280;
  margin-top: 12px;
  padding-right: 20px;
}

/* FOOTER */

footer {
  background: #111827;
  color: #ffffff;
  padding-top: 50px;
}

.footer-content {
  display: flex;
  justify-content: space-between;
  gap: 30px;
  padding-bottom: 40px;
}

.footer-logo {
  color: #ffffff;
}

.footer-content p {
  color: #9ca3af;
  margin-top: 10px;
}

.footer-links {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.footer-links a {
  color: #d1d5db;
  text-decoration: none;
  font-size: 14px;
}

.footer-links a:hover {
  color: #ffffff;
}

.copyright {
  border-top: 1px solid #374151;
  text-align: center;
  padding: 20px;
  color: #9ca3af;
  font-size: 13px;
}

/* MÓVIL */

@media (max-width: 850px) {

  nav {
    display: none;
  }

  .generator-card {
    grid-template-columns: 1fr;
  }

  .preview {
    border-left: none;
    border-top: 1px solid #e5e7eb;
  }

  .benefits-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .steps {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {

  .hero {
    padding: 60px 0;
  }

  .hero h1 {
    font-size: 43px;
  }

  .hero p {
    font-size: 16px;
  }

  .generator-section,
  .info-section,
  .faq-section {
    padding: 60px 0;
  }

  .section-title h2 {
    font-size: 30px;
  }

  .controls,
  .preview {
    padding: 22px;
  }

  .color-row {
    grid-template-columns: 1fr;
    gap: 5px;
  }

  .benefits-grid {
    grid-template-columns: 1fr;
  }

  .footer-content {
    flex-direction: column;
  }

  .type-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .type-btn {
    width: 100%;
  }
}
